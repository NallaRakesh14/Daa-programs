#include <iostream>
#include <vector>
using namespace std;

vector<int> graph[10];
bool visited[10];

bool dfs(int node, int parent) {
    visited[node] = true;

    for (int x : graph[node]) {
        if (!visited[x]) {
            if (dfs(x, node))
                return true;
        }
        else if (x != parent) {
            return true;
        }
    }

    return false;
}

int main() {
    int n, e;
    cin >> n >> e;

    for (int i = 0; i < e; i++) {
        int u, v;
        cin >> u >> v;

        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    if (dfs(0, -1))
        cout << "Cycle detected";
    else
        cout << "No cycle";

    return 0;
}

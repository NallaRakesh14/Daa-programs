#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> graph[10];
bool visited[10];

void DFS(int node) {
    visited[node] = true;
    cout << node << " ";

    for (int x : graph[node]) {
        if (!visited[x])
            DFS(x);
    }
}

void BFS(int start) {
    queue<int> q;
    bool vis[10] = {};

    q.push(start);
    vis[start] = true;

    while (!q.empty()) {
        int node = q.front();
        q.pop();

        cout << node << " ";

        for (int x : graph[node]) {
            if (!vis[x]) {
                vis[x] = true;
                q.push(x);
            }
        }
    }
}

int main() {
    graph[0] = {1, 2};
    graph[1] = {0, 3, 4};
    graph[2] = {0, 4};
    graph[3] = {1};
    graph[4] = {1, 2};

    cout << "DFS: ";
    DFS(0);

    cout << "\nBFS: ";
    BFS(0);

    return 0;
}
